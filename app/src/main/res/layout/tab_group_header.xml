<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tab_group_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/chrome_inner_margin"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="@dimen/chrome_inner_margin"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/group_collapse_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        app:srcCompat="@drawable/ic_action_delete"
        app:tint="?attr/iconColor" />

    <TextView
        android:id="@+id/group_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.OasisBrowser.TabTitle" />

    <TextView
        android:id="@+id/group_tab_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textAppearance="@style/TextAppearance.OasisBrowser.TabTitle" />

    <FrameLayout
        android:id="@+id/group_close"
        android:layout_width="@dimen/browser_icon_button_size"
        android:layout_height="match_parent"
        android:background="@drawable/icon_button_background"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/close_tab"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_action_delete"
            app:tint="?attr/iconColor" />
    </FrameLayout>
</LinearLayout>
